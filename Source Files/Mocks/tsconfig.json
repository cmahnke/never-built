{
  "compilerOptions": {
    "module": "esnext",
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "esModuleInterop": true,
    "strict": false,
    "allowJs": true,
    "typeRoots": [],
    "target": "es2022",
    "skipLibCheck": true,
    "lib": ["dom", "es2022"],
    "typeRoots": ["node_modules/@types", "3D/assets/ts/@types"]
  },
  "include": ["3D/assets/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts", "dist/**/*"]
}
